    { "name": "tomorrow becomes today", "date": "2026-11-09", "expect": "2026-11-08" },
    { "name": "next year becomes today", "date": "2027-01-01", "expect": "2026-11-08" },
    { "name": "an old date stays", "date": "1999-01-31", "expect": "1999-01-31" },
    { "name": "empty stays empty", "date": "", "expect": "" }
