    { "company_id": 1, "from_currency": "USD", "to_currency": "EGP", "date": "2024-03-06", "exchange_rate": 48 },
    { "company_id": 1, "from_currency": "USD", "to_currency": "EGP", "date": "2025-01-01", "exchange_rate": 50 },
    { "company_id": 1, "from_currency": "EURO", "to_currency": "EGP", "date": "2024-06-01", "exchange_rate": 52 },
    { "company_id": 2, "from_currency": "USD", "to_currency": "EGP", "date": "2024-01-01", "exchange_rate": 99 }
  ],
  "cases": [
    { "name": "the day a rate starts", "company_id": 1, "from": "USD", "to": "EGP", "date": "2024-03-06", "expect": 48 },
    { "name": "the day before it starts", "company_id": 1, "from": "USD", "to": "EGP", "date": "2024-03-05", "expect": 30 },
    { "name": "long after the last rate", "company_id": 1, "from": "USD", "to": "EGP", "date": "2026-11-08", "expect": 50 },
    { "name": "before the first rate", "company_id": 1, "from": "USD", "to": "EGP", "date": "2023-12-31", "expect": 1 },
